# WHY IPTV Environment Configuration
# Copy this file to .env.local for custom configurations

# Port configuration (Defaults to 5180 for classroom presentation)
VITE_PORT=5180

# Application Environment Mode ('development' | 'production')
NODE_ENV=production

# Optional CORS Proxy Service for External XMLTV Guides
# VITE_CORS_PROXY_URL=https://corsproxy.io/?

# Default UI Theme ('tivimate' | 'smarters' | 'cable')
VITE_DEFAULT_THEME=tivimate

# Timezone Setting ('device' | 'America/Toronto')
VITE_DEFAULT_TIMEZONE=device
